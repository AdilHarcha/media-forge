# Générer un .env avec de vrais secrets : ./scripts/gen-env.sh
POSTGRES_PASSWORD=change-me
API_KEY=change-me-api-key
# Garage : clé d'accès = GK + 24 hex, secret = 64 hex
S3_ACCESS_KEY=GKchangeme000000000000000
S3_SECRET_KEY=change-me-64-hex
GARAGE_RPC_SECRET=change-me-64-hex
# Optionnel : une clé par application (révocable seule), séparées par des virgules ; DL_SECRET fixe la signature des liens
#API_KEYS=cle-site-a,cle-site-b
#DL_SECRET=change-me
# Optionnel, génération d'images en mode « clé API » : clé OpenAI partagée par tous les utilisateurs de CETTE instance (ils ne saisissent plus la leur).
# Attention : quiconque possède une clé MediaForge dépense alors votre crédit OpenAI. Laisser vide = chaque utilisateur apporte sa clé.
#OPENAI_API_KEY=sk-...
#OPENAI_IMAGE_MODEL=gpt-image-1
